{
  "name": "akira/laravel-packagist",
  "description": "A modular SDK and Laravel integration for the Packagist.org API with typed DTOs, configurable caching strategies, and static analysis level max",
  "keywords": [
    "laravel",
    "packagist",
    "sdk",
    "api",
    "package-management",
    "composer"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "Kidiatoliny Gonçalves",
      "email": "kdiatoliny@gmail.com"
    }
  ],
  "require": {
    "php": "^8.4",
    "illuminate/support": "^12.0",
    "illuminate/console": "^12.0",
    "guzzlehttp/guzzle": "^7.9",
    "laravel/prompts": "^0.3.0",
    "spatie/laravel-package-tools": "^1.16"
  },
  "require-dev": {
    "laravel/pint": "^1.24.0",
    "orchestra/workbench": "^10.0",
    "peckphp/peck": "^0.1.3",
    "pestphp/pest": "^4.1.0",
    "pestphp/pest-plugin-type-coverage": "^4.0.2",
    "phpstan/phpstan": "^2.1.26",
    "rector/rector": "^2.1.7",
    "symfony/var-dumper": "^7.3.3"
  },
  "autoload": {
    "psr-4": {
      "Akira\\Packagist\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Akira\\Packagist\\Tests\\": "tests/"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "extra": {
    "laravel": {
      "providers": [
        "Akira\\Packagist\\Providers\\PackagistServiceProvider"
      ]
    }
  },
  "config": {
    "sort-packages": true,
    "preferred-install": "dist",
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "scripts": {
    "lint": "pint",
    "refactor": "rector",
    "test:type-coverage": "pest --type-coverage --exactly=96.7 --compact",
    "test:typos": "peck",
    "test:lint": "pint --test",
    "test:unit": "pest --coverage --exactly=15.6 --compact",
    "test:types": "phpstan",
    "test:refactor": "rector --dry-run",
    "test": [
      "@test:lint",
      "@test:type-coverage",
      "@test:typos",
      "@test:unit",
      "@test:types",
      "@test:refactor"
    ]
  }
}
